    class DATA,REPLAY,MODEL,SIGNAL source;
    class DASH,REVIEW,FOLLOW,HANDOVER,FAMILY clinical;
    class SNAPSHOT,GEMINI,VALIDATE ai;
    class DB,OPS storage;
