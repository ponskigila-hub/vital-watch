flowchart LR
    BROWSER["React application in the browser<br/>Clinician workspace or restricted family view"]
    PSV["PhysioNet PSV recordings<br/>Bundled demos or clinician imports"]
    subgraph HOST["IBM LinuxONE VM · s390x · Ubuntu"]
        subgraph PROCESS["One Uvicorn / FastAPI process"]
            API["HTTP routes and care services<br/>Sessions, CSRF and role/assignment checks"]
            CLOCK["Background replay/scoring task<br/>Shared patient-hour clock and cutoff enforcement"]
            MODEL["LightGBM v1 CPU inference<br/>Shared causal 127-feature preprocessing"]
            WORKER["Background language worker<br/>Approved snapshots and output validation"]
        end
        DB[("SQLite via SQLAlchemy<br/>Readings, results, care records and language jobs")]
        STATIC["Compiled React / Vite assets"]
        FILES["Model and threshold artifacts<br/>Demo references and private backend configuration"]
    end
    GEMINI["External Google Gemini API<br/>Optional language generation"]
    BROWSER <-->|"HTTP :8000 · same-origin JSON API"| API
    PSV -->|"Seed / validated import"| API
    STATIC -->|"Serve / and /assets"| API
    API <-->|"Read / write; queue generation jobs"| DB
    API -->|"Playback controls"| CLOCK
    CLOCK <-->|"Patient history / scores"| MODEL
    CLOCK <-->|"History, scores, alerts and queued jobs"| DB
    DB <-->|"Durable queued jobs and results"| WORKER
    FILES -.-> MODEL
    FILES -.-> WORKER
    WORKER <-->|"Outbound HTTPS: approved evidence / structured response"| GEMINI
