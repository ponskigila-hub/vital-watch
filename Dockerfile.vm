# VitalWatch image for IBM LinuxONE (s390x). NOT yet built on s390x - verify on the VM.
# Differences from the original Dockerfile:
#   1. copies src/ (api/app/inference.py imports src.features; without it the model is "unavailable")
#   2. Ubuntu base + apt numpy/pandas, because pip found no prebuilt s390x numpy wheel on the VM
#   3. no Node stage: frontend/dist is built on the laptop and copied in (remove the
#      "frontend/dist" line from .dockerignore before building)
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-venv python3-pip python3-dev python3-numpy python3-pandas python3-scipy \
        build-essential cmake libffi-dev libssl-dev libgomp1 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN python3 -m venv --system-site-packages /opt/venv
ENV PATH=/opt/venv/bin:$PATH
COPY requirements-vm.txt /app/requirements-vm.txt
RUN pip install --no-cache-dir -r /app/requirements-vm.txt
COPY api/ /app/api/
COPY src/ /app/src/
COPY models/ /app/models/
COPY frontend/dist /app/frontend/dist
RUN mkdir -p /app/api/runtime
EXPOSE 8000
CMD ["uvicorn", "api.app.main:app", "--host", "0.0.0.0", "--port", "8000"]