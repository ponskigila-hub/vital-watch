{
  "$defs": {
    "BaselineOutput": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "unavailable",
          "enum": [
            "unavailable",
            "insufficient_history",
            "ok",
            "example"
          ],
          "title": "Status",
          "type": "string"
        },
        "deviations": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Deviations",
          "type": "object"
        }
      },
      "title": "BaselineOutput",
      "type": "object"
    },
    "Factor": {
      "additionalProperties": false,
      "properties": {
        "feature": {
          "title": "Feature",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "measurement_direction": {
          "anyOf": [
            {
              "enum": [
                "up",
                "down",
                "unchanged"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measurement Direction"
        },
        "contribution": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contribution"
        },
        "observation_hours": {
          "items": {
            "type": "integer"
          },
          "title": "Observation Hours",
          "type": "array"
        }
      },
      "required": [
        "feature"
      ],
      "title": "Factor",
      "type": "object"
    },
    "SepsisOutput": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "unavailable",
          "enum": [
            "unavailable",
            "insufficient_history",
            "ok",
            "example"
          ],
          "title": "Status",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "band": {
          "anyOf": [
            {
              "enum": [
                "High",
                "Moderate",
                "Low"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Band"
        },
        "alert": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alert"
        },
        "alert_threshold": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alert Threshold"
        },
        "alert_policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alert Policy"
        },
        "factors": {
          "items": {
            "$ref": "#/$defs/Factor"
          },
          "title": "Factors",
          "type": "array"
        }
      },
      "title": "SepsisOutput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "patient_id": {
      "title": "Patient Id",
      "type": "string"
    },
    "as_of_hour": {
      "title": "As Of Hour",
      "type": "integer"
    },
    "status": {
      "enum": [
        "unavailable",
        "insufficient_history",
        "ok",
        "partial",
        "example"
      ],
      "title": "Status",
      "type": "string"
    },
    "sepsis": {
      "$ref": "#/$defs/SepsisOutput"
    },
    "baseline": {
      "$ref": "#/$defs/BaselineOutput"
    },
    "data_quality": {
      "additionalProperties": true,
      "title": "Data Quality",
      "type": "object"
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    },
    "feature_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Feature Version"
    },
    "origin": {
      "default": "disconnected",
      "enum": [
        "disconnected",
        "example",
        "model"
      ],
      "title": "Origin",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "patient_id",
    "as_of_hour",
    "status"
  ],
  "title": "PredictionResult",
  "type": "object"
}
