DATABASE_URL=sqlite:///api/runtime/vitalwatch.db
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
DEMO_SEED=true
DEMO_HELD_OUT=true
SESSION_HOURS=8
# Optional setup overrides; otherwise random demo passwords are generated locally.
# DEMO_CLINICIAN_PASSWORD=
# DEMO_FAMILY_PASSWORD=
# Local CPU sepsis inference; use disconnected only for explicit fixture testing.
PREDICTION_PROVIDER=lightgbm
SEPSIS_MODEL_PATH=models/model_v1.txt
SEPSIS_THRESHOLDS_PATH=models/thresholds_v1.json
SEPSIS_ALERT_POLICY=5pct_false_alert_patients
# Educational demo language integration. Explicitly opt in; never use real patient data.
LANGUAGE_PROVIDER=disconnected
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=2048
AI_MIN_INTERVAL_SECONDS=10
